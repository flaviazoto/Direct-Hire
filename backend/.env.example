# ─────────────────────────────────────────────────────────────
# DIRECT HIRE — Backend Environment Variables
# Copy this file: cp .env.example .env
# Then fill in every value marked with YOUR_ or _here
# Generate secrets with the commands shown in each section
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── URLs / CORS ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
# DATABASE_URL  — pooled connection (used by Prisma at runtime, pgbouncer mode)
# DIRECT_URL    — direct connection (used by Prisma migrations)
DATABASE_URL="postgresql://your_db_user:your_db_password@your_db_host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://your_db_user:your_db_password@your_db_host:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_64_chars_base64
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_64_chars_base64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Encryption ────────────────────────────────────────────────
# Must be exactly 64 hex characters (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_exactly_64_hex_chars

# ── Cron ──────────────────────────────────────────────────────
# Shared secret for scheduled job endpoints (X-Cron-Secret header)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=your_cron_secret_base64

# ── Storage ───────────────────────────────────────────────────
# STORAGE_PROVIDER: "local" | "supabase" | "s3"
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_jwt
SUPABASE_STORAGE_BUCKET=directhire-uploads

# ── Email ─────────────────────────────────────────────────────
# EMAIL_PROVIDER: "console" | "smtp" | "resend"
# Use "console" for local dev (prints to stdout, no real sends)
EMAIL_PROVIDER=resend

# FROM addresses are hardcoded in services/email/index.ts (FROM_NO_REPLY /
# FROM_HELLO / FROM_SUPPORT — all @directhire.cc), not read from env. There
# used to be EMAIL_FROM_ADDRESS / EMAIL_FROM_NAME vars here; removed because
# no code ever read them.

# Resend (active provider) — required if EMAIL_PROVIDER=resend; the app
# fails to start without this (see services/email/index.ts boot check)
RESEND_API_KEY=your_resend_api_key_here

# Optional: required only if using Resend audience/contact list sync
# RESEND_AUDIENCE_ID=your_resend_audience_id_here

# Resend bounce/complaint webhook (POST /api/webhooks/resend) — signing
# secret from the Resend Dashboard > Webhooks > your endpoint > Signing
# secret. Must also register the endpoint URL in the Resend dashboard
# manually — see this session's output for exact steps.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# SMTP fallback (used when EMAIL_PROVIDER=smtp)
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Owner-notification target — new registrations, new submissions, job
# resubmissions, and contact-form messages all go here. Falls back to a
# hardcoded address (services/email/index.ts) if unset — set this explicitly
# in every real deployment rather than relying on that fallback.
OWNER_EMAIL=you@your-domain.com

# ── Queue ─────────────────────────────────────────────────────
# JOBS_INLINE_MODE=true  → emails run inline in the request (dev / serverless)
# JOBS_INLINE_MODE=false → emails queued via BullMQ (requires REDIS_URL)
JOBS_INLINE_MODE=true
# REDIS_URL=redis://localhost:6379

# 


── Admin Seed ────────────────────────────────────────────────
# Credentials for the seeded admin account (backend/scripts/seed.ts)
ADMIN_SEED_EMAIL=admin@your-domain.com
ADMIN_SEED_PASSWORD=your_admin_seed_password_here

# ── Demo Seed ─────────────────────────────────────────────────
# Shared password for every account created by backend/scripts/seed-demo.ts
# (demo-worker-*/demo-employer-*/demo-admin@demo.directhire.cc). Required for
# --execute; the script refuses to run without it. Never used outside that
# script — not a general admin/app credential.
DEMO_SEED_PASSWORD=your_demo_seed_password_here

# ── OAuth — Google ────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Dead variable — was a typo and is never read by app code; kept here for reference only
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── OAuth — LinkedIn ──────────────────────────────────────────
# Create credentials at: https://www.linkedin.com/developers/apps
# Authorized redirect URI to register: {BACKEND_URL}/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ── Stripe ────────────────────────────────────────────────────
# Keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Webhook signing secret — from Stripe Dashboard > Webhooks > your endpoint > Signing secret
# For local dev use: stripe listen --forward-to localhost:4000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Create a recurring price in Stripe Dashboard and paste the price ID here (e.g. 5000 ALL/month)
STRIPE_EMPLOYER_PRICE_ID=price_your_employer_monthly_price_id

# ── AI Content Agent ──────────────────────────────────────────
# Anthropic API key — used by services/ai/anthropic-client.ts to generate
# SEO metadata (title/description/intro) for job posts at approval time.
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
