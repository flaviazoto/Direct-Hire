// Direct Hire — Production Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  WORKER
  EMPLOYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum OnboardingStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum FileType {
  PROFILE_PHOTO
  WORK_VIDEO
  INTRO_VIDEO
  MEDICAL_CERTIFICATE
  BUSINESS_DOCUMENT
  COMPANY_LOGO
  OTHER
}

enum FileStatus {
  UPLOADING
  UPLOADED
  FAILED
  DELETED
  SUPERSEDED
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailType {
  WELCOME
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ONBOARDING_REMINDER
  ONBOARDING_SUBMITTED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_NEEDS_CHANGES
  SUBSCRIPTION_CONFIRMED
  ADMIN_NEW_SUBMISSION
  APPLICATION_RECEIVED
  APPLICATION_SHORTLISTED
  APPLICATION_INTERVIEW_REQUESTED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  INVOICE_RECEIPT
  SYSTEM_HEALTH_ALERT
  // Suppressible (marketing-class) — see lib/unsubscribe.ts. Kept as its own
  // type rather than folded into GENERAL specifically so it CAN be
  // suppressed without also suppressing the many transactional emails that
  // reuse GENERAL (job moderation, lock lifecycle, posting rights, messages).
  JOB_MATCH
  GENERAL
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

enum NotificationType {
  MESSAGE_RECEIVED
  APPLICATION_SUBMITTED
  APPLICATION_UPDATE
  PROFILE_APPROVED
  PROFILE_REJECTED
  JOB_MATCH
  WORKER_LOCKED
  WORKER_LOCK_EXTENDED
  WORKER_LOCK_RELEASED
  LOCK_EXPIRY_WARNING
  LOCK_EXPIRED
  REVIEW_APPROVED
  REVIEW_REJECTED
  REVIEW_NEEDS_CHANGES
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_PENDING
  ADMIN_JOB_MODERATION
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REINSTATED
  new_job_pending
  lock_overridden
  GENERAL
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  INTERVIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum LockStatus {
  ACTIVE
  EXPIRED
  RELEASED
  OVERRIDDEN
}

enum ChargeStatus {
  PENDING
  CHARGED
  FAILED
  WAIVED
}

enum AccountStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VerificationCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AuditAction {
  USER_APPROVED
  USER_REJECTED
  USER_SUSPENDED
  USER_REINSTATED
  JOB_APPROVED
  JOB_REJECTED
  JOB_SUBMITTED
  JOB_CHANGES_REQUESTED
  JOB_ARCHIVED
  JOB_RESUBMITTED
  EMPLOYER_POSTING_RIGHTS_REVOKED
  EMPLOYER_POSTING_RIGHTS_RESTORED
  LOCK_OVERRIDDEN
  AI_DECISION_OVERRIDDEN
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  CONTACT_DETAILS_ACCESSED
  WORKER_LOCKED
  WORKER_LOCK_EXTENDED
  WORKER_LOCK_RELEASED
  WORKER_LOCK_EXPIRED
  WORKER_LOCK_OVERRIDDEN
  DOCUMENT_BATCH_REVIEWED
}

enum JobPostStatus {
  DRAFT
  PENDING_MODERATION
  APPROVED
  REJECTED
  ARCHIVED
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  FREELANCE
}

// ─────────────────────────────────────────────
// CORE USER
// ─────────────────────────────────────────────

model User {
  id                         String        @id @default(cuid())
  email                      String        @unique
  passwordHash               String
  role                       Role
  isEmailVerified            Boolean       @default(false)
  status                     UserStatus    @default(PENDING_VERIFICATION)
  accountStatus              AccountStatus @default(PENDING_EMAIL_VERIFICATION) @map("account_status")
  emailVerificationCodeHash  String?       @map("email_verification_code_hash")
  emailVerificationExpiresAt DateTime?     @map("email_verification_expires_at")
  emailVerificationAttempts  Int           @default(0) @map("email_verification_attempts")
  emailVerificationSentAt    DateTime?     @map("email_verification_sent_at")
  lastLoginAt                DateTime?
  verificationSubmittedAt    DateTime?     @map("verification_submitted_at")
  approvedAt                 DateTime?     @map("approved_at")
  rejectedAt                 DateTime?     @map("rejected_at")
  rejectionReason            String?       @map("rejection_reason")
  suspendedAt                DateTime?     @map("suspended_at")
  reviewedById               String?       @map("reviewed_by")
  postingRightsRevoked       Boolean       @default(false) @map("posting_rights_revoked")
  postingRightsRevokedAt     DateTime?     @map("posting_rights_revoked_at")
  postingRightsRevokedBy     String?       @map("posting_rights_revoked_by")
  isLocked                   Boolean       @default(false) @map("is_locked")
  lockedByEmployerId         String?       @map("locked_by_employer_id")
  lockedUntil                DateTime?     @map("locked_until")
  lockCount                  Int           @default(0) @map("lock_count")
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  googleId           String? @unique
  linkedinId         String? @unique
  avatarUrl          String?
  onboardingComplete Boolean @default(false)

  // GDPR explicit consent — captured at registration (standard email/password
  // signup only; see auth.controller.ts register()). NULL for every account
  // that predates this column, and for OAuth signups, which don't currently
  // pass through this checkbox — both are known, flagged gaps, not bugs to
  // silently paper over.
  consentAcceptedAt    DateTime?
  consentPolicyVersion String?

  // Non-transactional email suppression (unsubscribe). NULL = subscribed.
  // unsubscribeToken is random (not signed/JWT), generated lazily — see
  // lib/unsubscribe.ts — and looked up directly, same pattern as
  // PasswordResetToken/EmailVerificationToken but as a plain non-expiring
  // column since it's 1:1 with the user.
  emailUnsubscribedAt DateTime?
  unsubscribeToken    String?   @unique

  // Relations
  workerProfile         WorkerProfile?
  employerProfile       EmployerProfile?
  onboardingProgress    OnboardingProgress?
  uploads               Upload[]
  reviewedUploads       Upload[]                 @relation("UploadReviewedBy")
  emailLogs             EmailLog[]
  verificationRecord    VerificationRecord?
  sessions              Session[]
  emailVerifyTokens     EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  auditLogs             AuditLog[]
  reviewedBy            VerificationRecord[]     @relation("ReviewedBy")
  notifications         Notification[]
  verificationCodes     VerificationCode[]
  adminAuditLogs        AdminAuditLog[]          @relation("AdminAuditLogs")
  userAuditLogs         AdminAuditLog[]          @relation("UserAuditLogs")
  jobPosts              JobPost[]                @relation("EmployerJobs")
  externalJobsCreated   ExternalJob[]            @relation("ExternalJobsCreatedBy")
  workerApplications    Application[]            @relation("WorkerApplications")
  employerApplications  Application[]            @relation("EmployerApplications")
  workerLocksAsWorker   WorkerLock[]             @relation("WorkerLocks")
  workerLocksAsEmployer WorkerLock[]             @relation("EmployerLocks")
  sentMessages          Message[]                @relation("SentMessages")
  receivedMessages      Message[]                @relation("ReceivedMessages")
  payments              Payment[]
  invoices              Invoice[]

  @@index([email])
  @@index([role])
  @@index([status])
}

// ─────────────────────────────────────────────
// AUTH TABLES
// ─────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

// ─────────────────────────────────────────────
// WORKER PROFILE
// ─────────────────────────────────────────────

model WorkerProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  firstName           String?
  lastName            String?
  dateOfBirth         DateTime?
  nationality         String?
  countryOfResidence  String?
  city                String?
  address             String?
  passportNumber      String? // stored encrypted, text only
  phone               String? // stored encrypted, text only — same pattern as passportNumber
  maritalStatus       String?
  fatherName          String?
  motherName          String?
  hasSpouse           Boolean              @default(false)
  spouseName          String?
  numberOfChildren    Int                  @default(0)
  profession          String?
  yearsExperience     String?
  expectedSalary      String?
  availabilityDate    DateTime?
  additionalNotes     String?
  profileScore        Int? // AI-computed 0–100
  trustScore          Int? // AI-computed 0–100
  riskScore           Int? // AI-computed 0–100
  isSearchable        Boolean              @default(false)
  passportStatus      DocumentReviewStatus @default(PENDING)
  documentsVerified   Boolean              @default(false)
  documentsReviewedAt DateTime?
  documentsReviewedBy String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          WorkerSkill[]
  languages       WorkerLanguage[]
  targetCountries WorkerTargetCountry[]
  savedJobs       SavedJob[]

  @@index([userId])
}

model WorkerSkill {
  id              String        @id @default(cuid())
  workerProfileId String
  skill           String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, skill])
}

model WorkerLanguage {
  id               String        @id @default(cuid())
  workerProfileId  String
  language         String
  proficiencyLevel String
  workerProfile    WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, language])
}

model WorkerTargetCountry {
  id                 String        @id @default(cuid())
  workerProfileId    String
  country            String
  visaTypePreference String?
  workerProfile      WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, country])
}

// ─────────────────────────────────────────────
// EMPLOYER PROFILE
// ─────────────────────────────────────────────

model EmployerProfile {
  id                           String    @id @default(cuid())
  userId                       String    @unique
  companyName                  String?
  contactPersonName            String?
  nipt                         String?
  qkr                          String?
  administratorId              String? // encrypted
  phone                        String? // stored encrypted, text only — same pattern as WorkerProfile.phone
  industry                     String?
  companySize                  String?
  website                      String?
  country                      String?
  city                         String?
  address                      String?
  businessDescription          String?
  subscriptionPlan             String?
  subscriptionStatus           String?
  trialEndsAt                  DateTime?
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?
  subscriptionCurrentPeriodEnd DateTime?
  logoUrl                      String?
  isVerified                   Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiringCountries EmployerHiringCountry[]
  requiredSkills  EmployerRequiredSkill[]

  @@index([userId])
}

model EmployerHiringCountry {
  id                String          @id @default(cuid())
  employerProfileId String
  country           String
  employerProfile   EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([employerProfileId, country])
}

model EmployerRequiredSkill {
  id                String          @id @default(cuid())
  employerProfileId String
  skill             String
  employerProfile   EmployerProfile @relation(fields: [employerProfileId], references: [id], onDelete: Cascade)

  @@unique([employerProfileId, skill])
}

// ─────────────────────────────────────────────
// ONBOARDING PROGRESS
// ─────────────────────────────────────────────

model OnboardingProgress {
  id               String           @id @default(cuid())
  userId           String           @unique
  role             Role
  currentStep      Int              @default(0)
  completedSteps   Int[]            @default([])
  draftData        Json             @default("{}")
  isSubmitted      Boolean          @default(false)
  submittedAt      DateTime?
  lastSavedAt      DateTime         @default(now())
  onboardingStatus OnboardingStatus @default(DRAFT)
  totalSteps       Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([onboardingStatus])
}

// ─────────────────────────────────────────────
// UPLOADS
// ─────────────────────────────────────────────

model Upload {
  id           String               @id @default(cuid())
  userId       String
  reviewedById String?
  fileType     FileType
  fileName     String
  fileUrl      String
  filePath     String
  mimeType     String
  sizeBytes    Int
  status       FileStatus           @default(UPLOADING)
  reviewStatus DocumentReviewStatus @default(PENDING)
  reviewNotes  String?
  isPrivate    Boolean              @default(false)
  uploadedAt   DateTime             @default(now())
  reviewedAt   DateTime?
  deletedAt    DateTime?

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("UploadReviewedBy", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([fileType])
  @@index([reviewStatus])
  @@index([reviewedById])
}

// ─────────────────────────────────────────────
// VERIFICATION / REVIEW
// ─────────────────────────────────────────────

model VerificationRecord {
  id               String             @id @default(cuid())
  userId           String             @unique
  reviewStatus     VerificationStatus @default(PENDING)
  adminNotes       String?
  rejectionReason  String?
  changesRequested String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@index([reviewStatus])
}

// ─────────────────────────────────────────────
// JOB POSTS
// ─────────────────────────────────────────────

model JobPost {
  id         String @id @default(cuid())
  employerId String @map("employer_id")
  employer   User   @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Cascade)

  title        String
  companyName  String  @map("company_name")
  description  String  @db.Text
  requirements String  @db.Text
  benefits     String? @db.Text

  country       String
  city          String
  remoteAllowed Boolean @default(false) @map("remote_allowed")

  salaryMin      Decimal @map("salary_min") @db.Decimal(10, 2)
  salaryMax      Decimal @map("salary_max") @db.Decimal(10, 2)
  salaryCurrency String  @default("USD") @map("salary_currency")

  contractType       ContractType @map("contract_type")
  experienceRequired Int          @map("experience_required")
  category           String
  requiredSkills     String[]     @map("required_skills")
  languagesRequired  String[]     @default([]) @map("languages_required")

  visaSupport   Boolean @default(false) @map("visa_support")
  accommodation Boolean @default(false)

  applicationDeadline DateTime? @map("application_deadline")
  positionsAvailable  Int       @default(1) @map("positions_available")

  status                JobPostStatus @default(DRAFT)
  moderationNotes       String?       @map("moderation_notes")
  approvedBy            String?       @map("approved_by")
  approvedAt            DateTime?     @map("approved_at")
  rejectedAt            DateTime?     @map("rejected_at")
  archivedAt            DateTime?     @map("archived_at")
  changesRequestedAt    DateTime?     @map("changes_requested_at")
  changesRequestedBy    String?       @map("changes_requested_by")
  resubmittedAt         DateTime?     @map("resubmitted_at")
  moderationHistory     Json?         @map("moderation_history")
  employerPostingRights Boolean       @default(true) @map("employer_posting_rights")

  viewCount        Int @default(0) @map("view_count")
  applicationCount Int @default(0) @map("application_count")

  // AI Content Agent — generated once per job post, at approval time (see
  // enqueue("seo.generateJobMetadata", ...) in admin-jobs.controller.ts's
  // approveJob). seoGeneratedAt doubles as the idempotency flag: the
  // processor skips regenerating if it's already set.
  seoMetaTitle       String?   @map("seo_meta_title") @db.VarChar(70)
  seoMetaDescription String?   @map("seo_meta_description") @db.VarChar(200)
  seoIntro           String?   @map("seo_intro") @db.Text
  seoGeneratedAt     DateTime? @map("seo_generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications Application[]
  savedBy      SavedJob[]

  @@index([employerId])
  @@index([status])
  @@index([country])
  @@index([category])
  @@index([createdAt])
  @@index([status, country, category])
  @@map("job_posts")
}

// ─────────────────────────────────────────────
// EXTERNAL JOBS
// ─────────────────────────────────────────────
// Admin-curated links to jobs hosted elsewhere (EURES, LinkedIn, Indeed,
// national job boards) — surfaced in the worker feed and public jobs list
// so new workers have real inventory to browse from day one. Deliberately a
// SEPARATE model from JobPost: no employer, no Application pipeline, no
// match scoring. Do not add a nullable employerId here to "unify" the two —
// that would force every JobPost query/permission check to handle a
// half-populated employer relation.

model ExternalJob {
  id String @id @default(cuid())

  title       String
  description String @db.Text

  country String
  city    String?

  salaryMin      Decimal? @map("salary_min") @db.Decimal(10, 2)
  salaryMax      Decimal? @map("salary_max") @db.Decimal(10, 2)
  salaryCurrency String?  @map("salary_currency")

  contractType ContractType? @map("contract_type")

  externalUrl String @map("external_url")
  sourceName  String @map("source_name")

  // Plain string, not an enum — same convention as Payment.status: simple
  // admin-curated content doesn't need DB-level exhaustiveness, and it keeps
  // this table decoupled from an ALTER TYPE migration if a status like
  // "EXPIRED" gets added later.
  status String @default("ACTIVE") // ACTIVE | ARCHIVED

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ExternalJobsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([country])
  @@index([createdAt])
  @@map("external_jobs")
}

// ─────────────────────────────────────────────
// APPLICATIONS
// ─────────────────────────────────────────────

model Application {
  id String @id @default(cuid())

  workerId String @map("worker_id")
  worker   User   @relation("WorkerApplications", fields: [workerId], references: [id], onDelete: Cascade)

  jobId String  @map("job_id")
  job   JobPost @relation(fields: [jobId], references: [id], onDelete: Cascade)

  employerId String @map("employer_id")
  employer   User   @relation("EmployerApplications", fields: [employerId], references: [id])

  status ApplicationStatus @default(APPLIED)

  coverLetter String? @map("cover_letter") @db.Text
  workerNote  String? @map("worker_note") @db.Text

  interviewContactUnlocked Boolean   @default(false) @map("interview_contact_unlocked")
  companyContactVisibleAt  DateTime? @map("company_contact_visible_at")

  viewedAt      DateTime? @map("viewed_at")
  shortlistedAt DateTime? @map("shortlisted_at")
  interviewedAt DateTime? @map("interviewed_at")
  acceptedAt    DateTime? @map("accepted_at")
  rejectedAt    DateTime? @map("rejected_at")

  rejectionReason       String? @map("rejection_reason")
  interviewInstructions String? @map("interview_instructions")

  // Worker's response to an interview invitation — set via
  // POST /applications/:id/interview-response, independent of `status`
  // (status stays INTERVIEWED until the employer accepts/rejects separately).
  interviewResponse        String?   @map("interview_response") // "ACCEPTED" | "DECLINED"
  interviewResponseMessage String?   @map("interview_response_message") @db.Text
  interviewRespondedAt     DateTime? @map("interview_responded_at")

  matchScore Decimal? @map("match_score") @db.Decimal(5, 2)

  offeredSalary   Decimal?  @map("offered_salary") @db.Decimal(10, 2)
  offeredCurrency String?   @map("offered_currency")
  startDate       DateTime? @map("start_date")
  contractType    String?   @map("contract_type")
  hireConfirmedAt DateTime? @map("hire_confirmed_at")

  applicationFeeCents   Int?    @map("application_fee_cents")
  applicationFeePaid    Boolean @default(false) @map("application_fee_paid")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workerId, jobId])
  @@index([workerId])
  @@index([jobId])
  @@index([employerId])
  @@index([status])
  @@index([createdAt])
  @@map("applications")
}

model SavedJob {
  id              String   @id @default(cuid())
  workerProfileId String
  jobPostId       String
  createdAt       DateTime @default(now())

  workerProfile WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  jobPost       JobPost       @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, jobPostId])
  @@index([workerProfileId])
  @@index([jobPostId])
}

// ─────────────────────────────────────────────
// WORKER LOCK
// ─────────────────────────────────────────────

model WorkerLock {
  id                    String     @id @default(cuid())
  workerId              String     @map("worker_id")
  worker                User       @relation("WorkerLocks", fields: [workerId], references: [id], onDelete: Cascade)
  employerId            String     @map("employer_id")
  employer              User       @relation("EmployerLocks", fields: [employerId], references: [id], onDelete: Cascade)
  lockStatus            LockStatus @default(ACTIVE) @map("lock_status")
  dailyFee              Decimal    @map("daily_fee") @db.Decimal(10, 2)
  currency              String     @default("USD")
  lockStartDate         DateTime   @map("lock_start_date")
  lockExpiryDate        DateTime   @map("lock_expiry_date")
  lockDays              Int        @map("lock_days")
  totalBilled           Decimal    @default(0) @map("total_billed") @db.Decimal(10, 2)
  totalDaysBilled       Int        @default(0) @map("total_days_billed")
  releaseReason         String?    @map("release_reason")
  adminOverrideBy       String?    @map("admin_override_by")
  adminOverrideAt       DateTime?  @map("admin_override_at")
  adminOverrideNote     String?    @map("admin_override_note")
  expiryWarningSent     Boolean    @default(false) @map("expiry_warning_sent")
  stripePaymentIntentId String?    @map("stripe_payment_intent_id")
  stripeRefundId        String?    @map("stripe_refund_id")
  totalRefundedCents    Int        @default(0) @map("total_refunded_cents")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  billingCharges LockBillingCharge[]

  @@index([workerId, lockStatus])
  @@index([employerId])
  @@index([lockExpiryDate])
  @@map("worker_locks")
}

model LockBillingCharge {
  id                    String       @id @default(cuid())
  lockId                String       @map("lock_id")
  lock                  WorkerLock   @relation(fields: [lockId], references: [id], onDelete: Cascade)
  employerId            String       @map("employer_id")
  workerId              String       @map("worker_id")
  amount                Decimal      @db.Decimal(10, 2)
  currency              String       @default("USD")
  chargeDate            DateTime     @map("charge_date")
  chargeStatus          ChargeStatus @default(PENDING) @map("charge_status")
  invoiceId             String?      @map("invoice_id")
  stripePaymentIntentId String?      @map("stripe_payment_intent_id")
  stripeChargeId        String?      @map("stripe_charge_id")
  failureReason         String?      @map("failure_reason")
  retryCount            Int          @default(0) @map("retry_count")
  gracePeriodEndsAt     DateTime?    @map("grace_period_ends_at")
  createdAt             DateTime     @default(now()) @map("created_at")

  @@index([lockId])
  @@index([employerId])
  @@map("lock_billing_charges")
}

