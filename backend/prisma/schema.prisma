model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("platform_config")
}

// ─────────────────────────────────────────────
// GROWTH / MARKETING AGENT SYSTEM
// ─────────────────────────────────────────────
// Infrastructure only — GrowthAgentTask is the task/approval log for
// whatever agents get built on top of this (see
// services/growth/agent-runner.ts's AGENT_HANDLERS registry, empty for
// now), GrowthContentDraft is where agent-generated content lands pending
// admin review/publish. No agent logic, no relations to other models yet —
// deliberately standalone so this can be scaffolded without touching
// anything existing.

enum GrowthTaskStatus {
  PENDING
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
}

model GrowthAgentTask {
  id              String           @id @default(cuid())
  agentName       String           @map("agent_name")
  taskType        String           @map("task_type")
  status          GrowthTaskStatus @default(PENDING)
  inputData       Json?            @map("input_data")
  outputData      Json?            @map("output_data")
  summary         String?          @db.Text
  errorMessage    String?          @map("error_message") @db.Text
  approvedBy      String?          @map("approved_by")
  approvedAt      DateTime?        @map("approved_at")
  rejectedAt      DateTime?        @map("rejected_at")
  rejectionReason String?          @map("rejection_reason") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([agentName])
  @@index([status])
  @@index([createdAt])
  @@map("growth_agent_tasks")
}

model GrowthContentDraft {
  id              String           @id @default(cuid())
  contentType     String           @map("content_type")
  title           String
  slug            String           @unique
  body            String           @db.Text
  metaTitle       String?          @map("meta_title") @db.VarChar(70)
  metaDescription String?          @map("meta_description") @db.VarChar(200)
  targetKeyword   String?          @map("target_keyword")
  sourceTaskId    String?          @map("source_task_id")
  status          GrowthTaskStatus @default(PENDING)
  publishedAt     DateTime?        @map("published_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([contentType])
  @@index([status])
  @@map("growth_content_drafts")
}
